# Sao chép file này thành .env. Không commit .env.
APP_NAME="Financial Data Platform API"
ENVIRONMENT="local"

# ─── Vnstock ──────────────────────────────────────────────────────────────────
# Điền key lấy từ tài khoản Vnstock vào file .env local. Không commit key.
DATA_PROVIDER="VNSTOCK_FREE"
VNSTOCK_API_KEY=""
VNSTOCK_REQUESTS_PER_MINUTE="60"

# Credential dự phòng cho provider khác
DATA_PROVIDER_API_KEY=""

# ─── Paths ────────────────────────────────────────────────────────────────────
RAW_DATA_DIR="data/raw/ohlcv"
CURATED_DATA_DIR="data/curated/ohlcv"
SEED_RAW_DATA_DIR="reports/raw/ohlcv"
UNIVERSE_PATH="universe/ticker_universe_v1.csv"

# ─── API / CORS ───────────────────────────────────────────────────────────────
API_BASE_URL="http://localhost:8000"
CORS_ORIGINS="http://localhost:8501,http://localhost:5173,http://127.0.0.1:5173"

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_PASSWORD="changeme_local"
DATABASE_URL="postgresql+asyncpg://app_user:changeme_local@localhost:5432/financial_platform"

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Tạo secret ngẫu nhiên: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="super_secret_dev_key_change_in_prod"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="60"
JWT_REFRESH_TOKEN_EXPIRE_DAYS="30"

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Local: Mailhog (docker-compose). Cloud: AWS SES.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_TLS="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@financial-platform.local"

# ─── AWS (Cloud — điền khi deploy lên AWS) ────────────────────────────────────
# QUAN TRỌNG: Không commit các giá trị thật vào git.
# Cloud secrets được quản lý qua AWS Secrets Manager.
AWS_REGION="ap-southeast-1"
AWS_PROFILE="default"
SES_FROM_EMAIL="your-email@example.com"
# AWS_ACCESS_KEY_ID=""   # Không dùng ở local nếu đã có AWS CLI profile
# AWS_SECRET_ACCESS_KEY=""
